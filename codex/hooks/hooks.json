{
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "node \"${PLUGIN_ROOT}/hooks/relay.mjs\"",
            "timeout": 2,
            "statusMessage": "MASONS: Discover this chat"
          }
        ]
      }
    ],
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "node \"${PLUGIN_ROOT}/hooks/relay.mjs\"",
            "timeout": 2,
            "statusMessage": "MASONS: Refresh chat discovery"
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "node \"${PLUGIN_ROOT}/hooks/relay.mjs\"",
            "timeout": 2,
            "statusMessage": "MASONS: Check reception notices"
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "node \"${PLUGIN_ROOT}/hooks/relay.mjs\"",
            "timeout": 2,
            "statusMessage": "MASONS: Pause typing on completion"
          }
        ]
      }
    ],
    "Interrupt": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "node \"${PLUGIN_ROOT}/hooks/relay.mjs\"",
            "timeout": 2,
            "statusMessage": "MASONS: Pause typing on interruption"
          }
        ]
      }
    ]
  }
}
